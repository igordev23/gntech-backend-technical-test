# Copiar para .env e preencher. Nunca commitar valores reais.
# Documentação de cada variável: docs/getting-started.md.
# Não use valores de produção neste arquivo.

# PostgreSQL (ambiente local do Docker Compose)
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather
POSTGRES_DB=weather
POSTGRES_PORT=5432

# API
API_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Banco (execução fora do Docker; o compose sobrescreve com host "db")
DATABASE_URL=postgresql+psycopg://weather:weather@localhost:5432/weather
TEST_DATABASE_URL=postgresql+psycopg://weather:weather@localhost:5432/weather_test

# OpenWeather (https://openweathermap.org/api) — nunca commitar a chave real
OPENWEATHER_API_KEY=
OPENWEATHER_GEOCODING_BASE_URL=https://api.openweathermap.org/geo/1.0
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
OPENWEATHER_TIMEOUT_SECONDS=5
OPENWEATHER_MAX_RETRIES=2
